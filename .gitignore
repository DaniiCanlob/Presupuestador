# ---------------------------------------------------------------- dependencias
node_modules/
.pnpm-store/
.pnpm-state/

# El gestor del proyecto es pnpm (ver packageManager en package.json).
# Estos lockfiles solo aparecen si alguien corre npm o yarn por error, y tener
# dos lockfiles distintos es la receta para instalar versiones diferentes.
package-lock.json
yarn.lock

# ---------------------------------------------------------------- compilados
dist/
dist-ssr/
build/

# ---------------------------------------------------------------- secretos
