# Supabase · Settings -> Data API (URL) y Settings -> API Keys (llaves)

# Llave publicable: va al navegador, la protege el RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Llave secreta: salta el RLS. Solo para `npm run seed`, nunca en el navegador
# ni en el repositorio.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
